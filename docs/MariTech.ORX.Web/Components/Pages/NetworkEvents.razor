@page "/network-intelligence"
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Network Intelligence | MariTech ORX</PageTitle>

<div class="network-page">

    <div class="page-header">
        <div>
            <h1>Network Intelligence</h1>
            <p>Monitor events affecting the global trade network.</p>
        </div>

        <div class="live-status">
            <span></span>
            Live Database
        </div>
    </div>

    <div class="filters-card">

        <input @bind="search"
               @bind:event="oninput"
               placeholder="Search events, vessels, carriers..." />

        <input @bind="eventType"
               @bind:event="oninput"
               placeholder="Event type" />

        <select @bind="severity">
            <option value="">All Severities</option>
            <option value="Critical">Critical</option>
            <option value="High">High</option>
            <option value="Medium">Medium</option>
            <option value="Low">Low</option>
        </select>

        <input @bind="location"
               @bind:event="oninput"
               placeholder="Location" />

        <input @bind="carrier"
               @bind:event="oninput"
               placeholder="Carrier" />

        <button class="apply-button"
                @onclick="ApplyFilters">
            Apply
        </button>

        <button class="reset-button"
                @onclick="ResetFilters">
            Reset
        </button>

    </div>

    @if (loading)
    {
        <div class="state-card">
            Loading network events...
        </div>
    }
    else if (error)
    {
        <div class="error-card">
            <h3>Unable to load network events</h3>
            <p>Check that the ORX API is running.</p>

            <button @onclick="LoadEvents">
                Retry
            </button>
        </div>
    }
    else
    {
        <div class="summary-row">

            <div class="summary-card">
                <span>Total Events</span>
                <strong>@totalRecords</strong>
            </div>

            <div class="summary-card">
                <span>Current Page</span>
                <strong>@currentPage</strong>
            </div>

            <div class="summary-card">
                <span>Critical / High</span>
                <strong>@HighSeverityCount</strong>
            </div>

        </div>

        <div class="table-card">

            <div class="table-header">

                <div>
                    <h2>Network Events</h2>
                    <p>Real events from SQL Server</p>
                </div>

                <button class="refresh-button"
                        @onclick="LoadEvents">
                    ↻ Refresh
                </button>

            </div>

            @if (events.Count == 0)
            {
                <div class="empty-state">
                    No network events found.
                </div>
            }
            else
            {
                <div class="table-wrapper">

                    <table>

                        <thead>
                            <tr>
                                <th>Event ID</th>
                                <th>Type</th>
                                <th>Severity</th>
                                <th>Location</th>
                                <th>Carrier</th>
                                <th>Vessel</th>
                                <th>Trade Lane</th>
                                <th>Start Time</th>
                                <th>Confidence</th>
                                <th>Source</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in events)
                            {
                                <tr>

                                    <td class="event-id">
                                        @item.EventId
                                    </td>

                                    <td>
                                        @(item.EventType ?? "—")
                                    </td>

                                    <td>
                                        <span class="@GetSeverityClass(item.Severity)">
                                            @(item.Severity ?? "Unknown")
                                        </span>
                                    </td>

                                    <td>
                                        @(item.Location ?? "—")
                                    </td>

                                    <td>
                                        @(item.Carrier ?? "—")
                                    </td>

                                    <td>
                                        @(item.Vessel ?? "—")
                                    </td>

                                    <td>
                                        @(item.TradeLane ?? "—")
                                    </td>

                                    <td>
                                        @(item.StartTime?.ToString("dd MMM yyyy HH:mm") ?? "—")
                                    </td>

                                    <td>
                                        @FormatConfidence(item.Confidence)
                                    </td>

                                    <td>
                                        @(item.Source ?? "—")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="pagination">

                    <button disabled="@(currentPage <= 1)"
                            @onclick="PreviousPage">
                        ← Previous
                    </button>

                    <span>
                        Page <strong>@currentPage</strong>
                        of <strong>@totalPages</strong>
                    </span>

                    <button disabled="@(currentPage >= totalPages)"
                            @onclick="NextPage">
                        Next →
                    </button>

                </div>
            }

        </div>
    }

</div>

@code {

    private List<NetworkEventDto> events = new();

    private int currentPage = 1;
    private int pageSize = 20;

    private int totalRecords;
    private int totalPages;

    private bool loading = true;
    private bool error;

    private string search = "";
    private string eventType = "";
    private string severity = "";
    private string location = "";
    private string carrier = "";

    private int HighSeverityCount =>
        events.Count(e =>
            string.Equals(e.Severity, "Critical",
                StringComparison.OrdinalIgnoreCase) ||
            string.Equals(e.Severity, "High",
                StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadEvents();
    }

    private async Task LoadEvents()
    {
        loading = true;
        error = false;

        try
        {
            var client =
                HttpClientFactory.CreateClient("ORXApi");

            var url =
                $"network-events?page={currentPage}" +
                $"&pageSize={pageSize}" +
                $"&search={Uri.EscapeDataString(search)}" +
                $"&eventType={Uri.EscapeDataString(eventType)}" +
                $"&severity={Uri.EscapeDataString(severity)}" +
                $"&location={Uri.EscapeDataString(location)}" +
                $"&carrier={Uri.EscapeDataString(carrier)}";

            var response =
                await client.GetFromJsonAsync<
                    PagedResponse<NetworkEventDto>>(url);

            if (response != null)
            {
                events =
                    response.Data ?? new List<NetworkEventDto>();

                totalRecords = response.TotalRecords;
                totalPages = response.TotalPages;
            }
        }
        catch
        {
            error = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;

        await LoadEvents();
    }

    private async Task ResetFilters()
    {
        search = "";
        eventType = "";
        severity = "";
        location = "";
        carrier = "";

        currentPage = 1;

        await LoadEvents();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;

            await LoadEvents();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;

            await LoadEvents();
        }
    }

    private string GetSeverityClass(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "severity unknown";

        return value.ToLowerInvariant() switch
        {
            "critical" => "severity critical",
            "high" => "severity high",
            "medium" => "severity medium",
            "low" => "severity low",
            _ => "severity unknown"
        };
    }

    private string FormatConfidence(decimal? value)
    {
        if (!value.HasValue)
            return "—";

        return $"{value.Value:0.##}%";
    }

    public class PagedResponse<T>
    {
        public List<T>? Data { get; set; }

        public int Page { get; set; }

        public int PageSize { get; set; }

        public int TotalRecords { get; set; }

        public int TotalPages { get; set; }
    }

    public class NetworkEventDto
    {
        public string EventId { get; set; } = "";

        public string? EventType { get; set; }

        public string? Severity { get; set; }

        public string? Location { get; set; }

        public string? Carrier { get; set; }

        public string? Vessel { get; set; }

        public string? TradeLane { get; set; }

        public DateTime? StartTime { get; set; }

        public DateTime? EndTime { get; set; }

        public string? Description { get; set; }

        public string? Source { get; set; }

        public decimal? Confidence { get; set; }
    }
}