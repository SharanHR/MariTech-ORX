@page "/predictions"
@page "/prediction"
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Predictions | MariTech ORX</PageTitle>

<div class="predictions-page">

    <div class="page-header">
        <div>
            <h1>Predictions</h1>
            <p>Monitor forward-looking predictions generated by ORX models.</p>
        </div>

        <div class="live-status">
            <span></span>
            Live Database
        </div>
    </div>

    <div class="filters-card">

        <input @bind="search"
               @bind:event="oninput"
               placeholder="Search prediction, entity..." />

        <input @bind="entityType"
               @bind:event="oninput"
               placeholder="Entity type" />

        <input @bind="predictionType"
               @bind:event="oninput"
               placeholder="Prediction type" />

        <input @bind="predictionHorizon"
               @bind:event="oninput"
               placeholder="Horizon" />

        <input @bind="modelVersion"
               @bind:event="oninput"
               placeholder="Model version" />

        <button class="apply-button"
                @onclick="ApplyFilters">
            Apply
        </button>

        <button class="reset-button"
                @onclick="ResetFilters">
            Reset
        </button>

    </div>

    @if (loading)
    {
        <div class="state-card">
            Loading predictions...
        </div>
    }
    else if (error)
    {
        <div class="error-card">
            <h3>Unable to load predictions</h3>
            <p>Check that the ORX API is running.</p>

            <button @onclick="LoadPredictions">
                Retry
            </button>
        </div>
    }
    else
    {
        <div class="summary-row">

            <div class="summary-card">
                <span>Total Predictions</span>
                <strong>@totalRecords</strong>
            </div>

            <div class="summary-card">
                <span>Current Page</span>
                <strong>@currentPage</strong>
            </div>

            <div class="summary-card">
                <span>High Confidence</span>
                <strong>@HighConfidenceCount</strong>
            </div>

        </div>

        <div class="table-card">

            <div class="table-header">

                <div>
                    <h2>Prediction Registry</h2>
                    <p>Real prediction records from SQL Server</p>
                </div>

                <button class="refresh-button"
                        @onclick="LoadPredictions">
                    ↻ Refresh
                </button>

            </div>

            @if (predictions.Count == 0)
            {
                <div class="empty-state">
                    No predictions found.
                </div>
            }
            else
            {
                <div class="table-wrapper">

                    <table>

                        <thead>
                            <tr>
                                <th>Prediction ID</th>
                                <th>Entity</th>
                                <th>Entity ID</th>
                                <th>Prediction Type</th>
                                <th>Predicted Value</th>
                                <th>Probability</th>
                                <th>Horizon</th>
                                <th>Model Version</th>
                                <th>Generated</th>
                                <th>Expires</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var prediction in predictions)
                            {
                                <tr>

                                    <td class="prediction-id">
                                        @prediction.PredictionId
                                    </td>

                                    <td>
                                        @(prediction.EntityType ?? "—")
                                    </td>

                                    <td>
                                        @(prediction.EntityId ?? "—")
                                    </td>

                                    <td>
                                        @(prediction.PredictionType ?? "—")
                                    </td>

                                    <td class="predicted-value">
                                        @(prediction.PredictedValue?.ToString("0.##") ?? "—")
                                    </td>

                                    <td>
                                        <span class="@GetProbabilityClass(prediction.Probability)">
                                            @FormatProbability(prediction.Probability)
                                        </span>
                                    </td>

                                    <td>
                                        @(prediction.PredictionHorizon ?? "—")
                                    </td>

                                    <td>
                                        @(prediction.ModelVersion ?? "—")
                                    </td>

                                    <td>
                                        @(prediction.GeneratedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")
                                    </td>

                                    <td>
                                        @(prediction.ExpiresAt?.ToString("dd MMM yyyy HH:mm") ?? "—")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="pagination">

                    <button disabled="@(currentPage <= 1)"
                            @onclick="PreviousPage">
                        ← Previous
                    </button>

                    <span>
                        Page <strong>@currentPage</strong>
                        of <strong>@totalPages</strong>
                    </span>

                    <button disabled="@(currentPage >= totalPages)"
                            @onclick="NextPage">
                        Next →
                    </button>

                </div>
            }

        </div>
    }

</div>

@code {

    private List<PredictionDto> predictions = new();

    private int currentPage = 1;
    private int pageSize = 20;

    private int totalRecords;
    private int totalPages;

    private bool loading = true;
    private bool error;

    private string search = "";
    private string entityType = "";
    private string predictionType = "";
    private string predictionHorizon = "";
    private string modelVersion = "";

    private int HighConfidenceCount =>
        predictions.Count(p =>
            p.Probability.HasValue &&
            p.Probability.Value >= 80);

    protected override async Task OnInitializedAsync()
    {
        await LoadPredictions();
    }

    private async Task LoadPredictions()
    {
        loading = true;
        error = false;

        try
        {
            var client =
                HttpClientFactory.CreateClient("ORXApi");

            var url =
                $"predictions?page={currentPage}" +
                $"&pageSize={pageSize}" +
                $"&search={Uri.EscapeDataString(search)}" +
                $"&entityType={Uri.EscapeDataString(entityType)}" +
                $"&predictionType={Uri.EscapeDataString(predictionType)}" +
                $"&predictionHorizon={Uri.EscapeDataString(predictionHorizon)}" +
                $"&modelVersion={Uri.EscapeDataString(modelVersion)}";

            var response =
                await client.GetFromJsonAsync<
                    PagedResponse<PredictionDto>>(url);

            if (response != null)
            {
                predictions =
                    response.Data ??
                    new List<PredictionDto>();

                totalRecords = response.TotalRecords;
                totalPages = response.TotalPages;
            }
        }
        catch
        {
            error = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;

        await LoadPredictions();
    }

    private async Task ResetFilters()
    {
        search = "";
        entityType = "";
        predictionType = "";
        predictionHorizon = "";
        modelVersion = "";

        currentPage = 1;

        await LoadPredictions();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;

            await LoadPredictions();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;

            await LoadPredictions();
        }
    }

    private string FormatProbability(decimal? value)
    {
        if (!value.HasValue)
            return "—";

        return $"{value.Value:0.##}%";
    }

    private string GetProbabilityClass(decimal? value)
    {
        if (!value.HasValue)
            return "probability unknown";

        if (value.Value >= 80)
            return "probability high";

        if (value.Value >= 50)
            return "probability medium";

        return "probability low";
    }

    public class PagedResponse<T>
    {
        public List<T>? Data { get; set; }

        public int Page { get; set; }

        public int PageSize { get; set; }

        public int TotalRecords { get; set; }

        public int TotalPages { get; set; }
    }

    public class PredictionDto
    {
        public string PredictionId { get; set; } = "";

        public string? EntityType { get; set; }

        public string? EntityId { get; set; }

        public string? PredictionType { get; set; }

        public decimal? PredictedValue { get; set; }

        public decimal? Probability { get; set; }

        public string? PredictionHorizon { get; set; }

        public string? ModelVersion { get; set; }

        public DateTime? GeneratedAt { get; set; }

        public DateTime? ExpiresAt { get; set; }
    }
}