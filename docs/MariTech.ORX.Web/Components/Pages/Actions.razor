@page "/actions"
@page "/action"

@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Actions | MariTech ORX</PageTitle>

<div class="actions-page">

    <div class="page-header">
        <div>
            <h1>Actions</h1>
            <p>Track operational actions initiated from ORX recommendations.</p>
        </div>

        <div class="live-status">
            <span></span>
            Live Database
        </div>
    </div>

    <div class="filters-card">

        <input @bind="search"
               @bind:event="oninput"
               placeholder="Search actions..." />

        <input @bind="recommendationId"
               @bind:event="oninput"
               placeholder="Recommendation ID" />

        <input @bind="actor"
               @bind:event="oninput"
               placeholder="Actor" />

        <input @bind="actionType"
               @bind:event="oninput"
               placeholder="Action type" />

        <input @bind="target"
               @bind:event="oninput"
               placeholder="Target" />

        <select @bind="status">
            <option value="">All Statuses</option>
            <option value="Pending">Pending</option>
            <option value="Requested">Requested</option>
            <option value="Approved">Approved</option>
            <option value="InProgress">In Progress</option>
            <option value="Completed">Completed</option>
            <option value="Rejected">Rejected</option>
            <option value="Failed">Failed</option>
        </select>

        <button class="apply-button"
                @onclick="ApplyFilters">
            Apply
        </button>

        <button class="reset-button"
                @onclick="ResetFilters">
            Reset
        </button>

    </div>

    @if (loading)
    {
        <div class="state-card">
            Loading actions...
        </div>
    }
    else if (error)
    {
        <div class="error-card">
            <h3>Unable to load actions</h3>

            <p>
                Check that the ORX API is running.
            </p>

            <button @onclick="LoadActions">
                Retry
            </button>
        </div>
    }
    else
    {
        <div class="summary-row">

            <div class="summary-card">
                <span>Total Actions</span>
                <strong>@totalRecords</strong>
            </div>

            <div class="summary-card">
                <span>Completed</span>
                <strong>@CompletedCount</strong>
            </div>

            <div class="summary-card">
                <span>Pending</span>
                <strong>@PendingCount</strong>
            </div>

            <div class="summary-card">
                <span>Current Page</span>
                <strong>@currentPage</strong>
            </div>

        </div>

        <div class="table-card">

            <div class="table-header">

                <div>
                    <h2>Operational Action Registry</h2>
                    <p>Real action records from SQL Server</p>
                </div>

                <button class="refresh-button"
                        @onclick="LoadActions">
                    ↻ Refresh
                </button>

            </div>

            @if (actions.Count == 0)
            {
                <div class="empty-state">
                    No actions found.
                </div>
            }
            else
            {
                <div class="table-wrapper">

                    <table>

                        <thead>
                            <tr>
                                <th>Action ID</th>
                                <th>Recommendation ID</th>
                                <th>Actor</th>
                                <th>Action Type</th>
                                <th>Target</th>
                                <th>Status</th>
                                <th>Requested At</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var action in actions)
                            {
                                <tr>

                                    <td class="action-id">
                                        @action.ActionId
                                    </td>

                                    <td class="recommendation-id">
                                        @action.RecommendationId
                                    </td>

                                    <td>
                                        @(action.Actor ?? "—")
                                    </td>

                                    <td>
                                        @(action.ActionType ?? "—")
                                    </td>

                                    <td class="target-cell"
                                        title="@action.Target">
                                        @(action.Target ?? "—")
                                    </td>

                                    <td>
                                        <span class="@GetStatusClass(action.Status)">
                                            @(action.Status ?? "Unknown")
                                        </span>
                                    </td>

                                    <td>
                                        @(action.RequestedAt?
                                            .ToString("dd MMM yyyy HH:mm")
                                            ?? "—")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="pagination">

                    <button disabled="@(currentPage <= 1)"
                            @onclick="PreviousPage">
                        ← Previous
                    </button>

                    <span>
                        Page <strong>@currentPage</strong>
                        of <strong>@totalPages</strong>
                    </span>

                    <button disabled="@(currentPage >= totalPages)"
                            @onclick="NextPage">
                        Next →
                    </button>

                </div>
            }

        </div>
    }

</div>

@code {

    private List<ActionDto> actions = new();

    private int currentPage = 1;
    private int pageSize = 20;

    private int totalRecords;
    private int totalPages;

    private bool loading = true;
    private bool error;

    private string search = "";
    private string recommendationId = "";
    private string actor = "";
    private string actionType = "";
    private string status = "";
    private string target = "";

    private int CompletedCount =>
        actions.Count(a =>
            string.Equals(
                a.Status,
                "Completed",
                StringComparison.OrdinalIgnoreCase));

    private int PendingCount =>
        actions.Count(a =>
            string.Equals(
                a.Status,
                "Pending",
                StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadActions();
    }

    private async Task LoadActions()
    {
        loading = true;
        error = false;

        try
        {
            var client =
                HttpClientFactory.CreateClient("ORXApi");

            var url =
                $"actions?page={currentPage}" +
                $"&pageSize={pageSize}" +
                $"&search={Uri.EscapeDataString(search)}" +
                $"&recommendationId={Uri.EscapeDataString(recommendationId)}" +
                $"&actor={Uri.EscapeDataString(actor)}" +
                $"&actionType={Uri.EscapeDataString(actionType)}" +
                $"&status={Uri.EscapeDataString(status)}" +
                $"&target={Uri.EscapeDataString(target)}";

            var response =
                await client.GetFromJsonAsync<
                    PagedResponse<ActionDto>>(url);

            if (response != null)
            {
                actions =
                    response.Data ??
                    new List<ActionDto>();

                totalRecords = response.TotalRecords;
                totalPages = response.TotalPages;
            }
        }
        catch
        {
            error = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;

        await LoadActions();
    }

    private async Task ResetFilters()
    {
        search = "";
        recommendationId = "";
        actor = "";
        actionType = "";
        status = "";
        target = "";

        currentPage = 1;

        await LoadActions();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;

            await LoadActions();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;

            await LoadActions();
        }
    }

    private string GetStatusClass(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "status unknown";

        return value.ToLowerInvariant() switch
        {
            "pending" => "status pending",
            "requested" => "status requested",
            "approved" => "status approved",
            "inprogress" => "status in-progress",
            "completed" => "status completed",
            "rejected" => "status rejected",
            "failed" => "status failed",
            _ => "status unknown"
        };
    }

    public class PagedResponse<T>
    {
        public List<T>? Data { get; set; }

        public int Page { get; set; }

        public int PageSize { get; set; }

        public int TotalRecords { get; set; }

        public int TotalPages { get; set; }
    }

    public class ActionDto
    {
        public string ActionId { get; set; } = "";

        public string RecommendationId { get; set; } = "";

        public string? Actor { get; set; }

        public string? ActionType { get; set; }

        public string? Target { get; set; }

        public string? Status { get; set; }

        public DateTime? RequestedAt { get; set; }
    }
}