@page "/risk-assessments"
@page "/risk"
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Risk Assessments | MariTech ORX</PageTitle>

<div class="risk-page">

    <div class="page-header">
        <div>
            <h1>Risk Assessments</h1>
            <p>Identify and monitor operational risks across trades and shipments.</p>
        </div>

        <div class="live-status">
            <span></span>
            Live Database
        </div>
    </div>

    <div class="filters-card">

        <input @bind="search"
               @bind:event="oninput"
               placeholder="Search risk, trade, shipment..." />

        <input @bind="riskType"
               @bind:event="oninput"
               placeholder="Risk type" />

        <select @bind="severity">
            <option value="">All Severities</option>
            <option value="Critical">Critical</option>
            <option value="High">High</option>
            <option value="Medium">Medium</option>
            <option value="Low">Low</option>
        </select>

        <input type="number"
               @bind="minScore"
               placeholder="Min score" />

        <input type="number"
               @bind="maxScore"
               placeholder="Max score" />

        <button class="apply-button"
                @onclick="ApplyFilters">
            Apply
        </button>

        <button class="reset-button"
                @onclick="ResetFilters">
            Reset
        </button>

    </div>

    @if (loading)
    {
        <div class="state-card">
            Loading risk assessments...
        </div>
    }
    else if (error)
    {
        <div class="error-card">
            <h3>Unable to load risk assessments</h3>
            <p>Check that the ORX API is running.</p>

            <button @onclick="LoadRisks">
                Retry
            </button>
        </div>
    }
    else
    {
        <div class="summary-row">

            <div class="summary-card">
                <span>Total Assessments</span>
                <strong>@totalRecords</strong>
            </div>

            <div class="summary-card danger">
                <span>High / Critical</span>
                <strong>@HighRiskCount</strong>
            </div>

            <div class="summary-card">
                <span>Average Score</span>
                <strong>@AverageScore.ToString("0.##")</strong>
            </div>

        </div>

        <div class="table-card">

            <div class="table-header">

                <div>
                    <h2>Risk Assessment Registry</h2>
                    <p>Real records from SQL Server</p>
                </div>

                <button class="refresh-button"
                        @onclick="LoadRisks">
                    ↻ Refresh
                </button>

            </div>

            @if (risks.Count == 0)
            {
                <div class="empty-state">
                    No risk assessments found.
                </div>
            }
            else
            {
                <div class="table-wrapper">

                    <table>

                        <thead>
                            <tr>
                                <th>Risk ID</th>
                                <th>Trade ID</th>
                                <th>Shipment ID</th>
                                <th>Risk Type</th>
                                <th>Score</th>
                                <th>Probability</th>
                                <th>Severity</th>
                                <th>Reason</th>
                                <th>Calculated</th>
                                <th>Expires</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var risk in risks)
                            {
                                <tr>

                                    <td class="risk-id">
                                        @risk.RiskId
                                    </td>

                                    <td>
                                        @risk.TradeId
                                    </td>

                                    <td>
                                        @risk.ShipmentId
                                    </td>

                                    <td>
                                        @(risk.RiskType ?? "—")
                                    </td>

                                    <td>
                                        <span class="@GetScoreClass(risk.Score)">
                                            @(risk.Score?.ToString("0.##") ?? "—")
                                        </span>
                                    </td>

                                    <td>
                                        @FormatProbability(risk.Probability)
                                    </td>

                                    <td>
                                        <span class="@GetSeverityClass(risk.Severity)">
                                            @(risk.Severity ?? "Unknown")
                                        </span>
                                    </td>

                                    <td class="reason-cell"
                                        title="@risk.Reason">
                                        @(risk.Reason ?? "—")
                                    </td>

                                    <td>
                                        @(risk.CalculatedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")
                                    </td>

                                    <td>
                                        @(risk.ExpiresAt?.ToString("dd MMM yyyy HH:mm") ?? "—")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <div class="pagination">

                    <button disabled="@(currentPage <= 1)"
                            @onclick="PreviousPage">
                        ← Previous
                    </button>

                    <span>
                        Page <strong>@currentPage</strong>
                        of <strong>@totalPages</strong>
                    </span>

                    <button disabled="@(currentPage >= totalPages)"
                            @onclick="NextPage">
                        Next →
                    </button>

                </div>
            }

        </div>
    }

</div>

@code {

    private List<RiskAssessmentDto> risks = new();

    private int currentPage = 1;
    private int pageSize = 20;

    private int totalRecords;
    private int totalPages;

    private bool loading = true;
    private bool error;

    private string search = "";
    private string riskType = "";
    private string severity = "";

    private decimal? minScore;
    private decimal? maxScore;

    private int HighRiskCount =>
        risks.Count(r =>
            string.Equals(
                r.Severity,
                "Critical",
                StringComparison.OrdinalIgnoreCase)
            ||
            string.Equals(
                r.Severity,
                "High",
                StringComparison.OrdinalIgnoreCase));

    private decimal AverageScore =>
        risks.Count == 0
            ? 0
            : risks
                .Where(r => r.Score.HasValue)
                .Select(r => r.Score!.Value)
                .DefaultIfEmpty()
                .Average();

    protected override async Task OnInitializedAsync()
    {
        await LoadRisks();
    }

    private async Task LoadRisks()
    {
        loading = true;
        error = false;

        try
        {
            var client =
                HttpClientFactory.CreateClient("ORXApi");

            var url =
                $"risk-assessments?page={currentPage}" +
                $"&pageSize={pageSize}" +
                $"&search={Uri.EscapeDataString(search)}" +
                $"&riskType={Uri.EscapeDataString(riskType)}" +
                $"&severity={Uri.EscapeDataString(severity)}";

            if (minScore.HasValue)
            {
                url += $"&minScore={minScore.Value}";
            }

            if (maxScore.HasValue)
            {
                url += $"&maxScore={maxScore.Value}";
            }

            var response =
                await client.GetFromJsonAsync<
                    PagedResponse<RiskAssessmentDto>>(url);

            if (response != null)
            {
                risks =
                    response.Data ??
                    new List<RiskAssessmentDto>();

                totalRecords = response.TotalRecords;
                totalPages = response.TotalPages;
            }
        }
        catch
        {
            error = true;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;

        await LoadRisks();
    }

    private async Task ResetFilters()
    {
        search = "";
        riskType = "";
        severity = "";

        minScore = null;
        maxScore = null;

        currentPage = 1;

        await LoadRisks();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;

            await LoadRisks();
        }
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;

            await LoadRisks();
        }
    }

    private string GetSeverityClass(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "severity unknown";

        return value.ToLowerInvariant() switch
        {
            "critical" => "severity critical",
            "high" => "severity high",
            "medium" => "severity medium",
            "low" => "severity low",
            _ => "severity unknown"
        };
    }

    private string GetScoreClass(decimal? score)
    {
        if (!score.HasValue)
            return "score normal";

        if (score.Value >= 80)
            return "score critical";

        if (score.Value >= 60)
            return "score high";

        if (score.Value >= 40)
            return "score medium";

        return "score low";
    }

    private string FormatProbability(decimal? value)
    {
        if (!value.HasValue)
            return "—";

        return $"{value.Value:0.##}%";
    }

    public class PagedResponse<T>
    {
        public List<T>? Data { get; set; }

        public int Page { get; set; }

        public int PageSize { get; set; }

        public int TotalRecords { get; set; }

        public int TotalPages { get; set; }
    }

    public class RiskAssessmentDto
    {
        public string RiskId { get; set; } = "";

        public string TradeId { get; set; } = "";

        public string ShipmentId { get; set; } = "";

        public string? RiskType { get; set; }

        public decimal? Score { get; set; }

        public decimal? Probability { get; set; }

        public string? Severity { get; set; }

        public string? Reason { get; set; }

        public string? Evidence { get; set; }

        public DateTime? CalculatedAt { get; set; }

        public DateTime? ExpiresAt { get; set; }
    }
}