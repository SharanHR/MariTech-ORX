@page "/recommendations"
@page "/recommendation"

@using System.Net.Http.Json

@inject IHttpClientFactory HttpClientFactory

<PageTitle>Recommendations | MariTech ORX</PageTitle>

<div class="recommendations-page">

    <div class="page-header">

        <div>
            <h1>Recommendations</h1>
            <p>AI-assisted actions recommended to reduce operational risk.</p>
        </div>

        <div class="live-status">
            <span></span>
            Live Database
        </div>

    </div>


    <div class="filters-card">

        <input @bind="search"
               @bind:event="oninput"
               placeholder="Search recommendations..." />

        <input @bind="tradeId"
               @bind:event="oninput"
               placeholder="Trade ID" />

        <input @bind="recommendationType"
               @bind:event="oninput"
               placeholder="Recommendation type" />

        <select @bind="status">

            <option value="">
                All Statuses
            </option>

            <option value="Pending">
                Pending
            </option>

            <option value="Approved">
                Approved
            </option>

            <option value="Rejected">
                Rejected
            </option>

            <option value="Completed">
                Completed
            </option>

        </select>


        <button class="apply-button"
                @onclick="ApplyFilters">

            Apply

        </button>


        <button class="reset-button"
                @onclick="ResetFilters">

            Reset

        </button>

    </div>


    @if (loading)
    {
        <div class="state-card">

            Loading recommendations...

        </div>
    }
    else if (error)
    {
        <div class="error-card">

            <h3>
                Unable to load recommendations
            </h3>

            <p>
                Check that the ORX API is running.
            </p>

            <button @onclick="LoadRecommendations">
                Retry
            </button>

        </div>
    }
    else
    {

        <div class="summary-row">

            <div class="summary-card">

                <span>
                    Total Recommendations
                </span>

                <strong>
                    @totalRecords
                </strong>

            </div>


            <div class="summary-card">

                <span>
                    High Confidence
                </span>

                <strong>
                    @HighConfidenceCount
                </strong>

            </div>


            <div class="summary-card">

                <span>
                    Avg Risk Reduction
                </span>

                <strong>
                    @AverageRiskReduction.ToString("0.##")
                </strong>

            </div>


            <div class="summary-card">

                <span>
                    Current Page
                </span>

                <strong>
                    @currentPage
                </strong>

            </div>

        </div>


        <div class="table-card">

            <div class="table-header">

                <div>

                    <h2>
                        Recommendation Registry
                    </h2>

                    <p>
                        Real recommendations from SQL Server
                    </p>

                </div>


                <button class="refresh-button"
                        @onclick="LoadRecommendations">

                    ↻ Refresh

                </button>

            </div>


            @if (recommendations.Count == 0)
            {
                <div class="empty-state">

                    No recommendations found.

                </div>
            }
            else
            {

                <div class="table-wrapper">

                    <table>

                        <thead>

                            <tr>

                                <th>
                                    Recommendation ID
                                </th>

                                <th>
                                    Trade ID
                                </th>

                                <th>
                                    Trigger Event
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Recommended Action
                                </th>

                                <th>
                                    Reason
                                </th>

                                <th>
                                    Expected Benefit
                                </th>

                                <th>
                                    Estimated Cost
                                </th>

                                <th>
                                    Risk Reduction
                                </th>

                                <th>
                                    Confidence
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var recommendation in recommendations)
                            {

                                <tr>

                                    <td class="recommendation-id">

                                        @recommendation.RecommendationId

                                    </td>


                                    <td>

                                        @recommendation.TradeId

                                    </td>


                                    <td>

                                        @(recommendation.TriggerEvent ?? "—")

                                    </td>


                                    <td>

                                        @(recommendation.RecommendationType ?? "—")

                                    </td>


                                    <td class="action-cell">

                                        @(recommendation.Action ?? "—")

                                    </td>


                                    <td class="reason-cell"
                                        title="@recommendation.Reason">

                                        @(recommendation.Reason ?? "—")

                                    </td>


                                    <td class="benefit-cell"
                                        title="@recommendation.ExpectedBenefit">

                                        @(recommendation.ExpectedBenefit ?? "—")

                                    </td>


                                    <td>

                                        @FormatCost(
                                            recommendation.EstimatedCost)

                                    </td>


                                    <td>

                                        <span class="@GetRiskReductionClass(
                                            recommendation.RiskReduction)">

                                            @FormatPercentage(
                                                recommendation.RiskReduction)

                                        </span>

                                    </td>


                                    <td>

                                        <span class="@GetConfidenceClass(
                                            recommendation.Confidence)">

                                            @FormatPercentage(
                                                recommendation.Confidence)

                                        </span>

                                    </td>


                                    <td>

                                        <span class="@GetStatusClass(
                                            recommendation.Status)">

                                            @(recommendation.Status ?? "Unknown")

                                        </span>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>


                <div class="pagination">

                    <button disabled="@(currentPage <= 1)"
                            @onclick="PreviousPage">

                        ← Previous

                    </button>


                    <span>

                        Page
                        <strong>@currentPage</strong>
                        of
                        <strong>@totalPages</strong>

                    </span>


                    <button disabled="@(currentPage >= totalPages)"
                            @onclick="NextPage">

                        Next →

                    </button>

                </div>

            }

        </div>

    }

</div>


@code {

    private List<RecommendationDto> recommendations = new();


    private int currentPage = 1;

    private int pageSize = 20;

    private int totalRecords;

    private int totalPages;


    private bool loading = true;

    private bool error;


    private string search = "";

    private string tradeId = "";

    private string recommendationType = "";

    private string status = "";


    private int HighConfidenceCount =>
        recommendations.Count(r =>
            r.Confidence.HasValue &&
            r.Confidence.Value >= 80);


    private decimal AverageRiskReduction =>
        recommendations
            .Where(r => r.RiskReduction.HasValue)
            .Select(r => r.RiskReduction!.Value)
            .DefaultIfEmpty()
            .Average();


    protected override async Task OnInitializedAsync()
    {
        await LoadRecommendations();
    }


    private async Task LoadRecommendations()
    {

        loading = true;

        error = false;


        try
        {

            var client =
                HttpClientFactory.CreateClient("ORXApi");


            var url =
                $"recommendations?page={currentPage}" +
                $"&pageSize={pageSize}" +
                $"&search={Uri.EscapeDataString(search)}" +
                $"&tradeId={Uri.EscapeDataString(tradeId)}" +
                $"&recommendationType={Uri.EscapeDataString(recommendationType)}" +
                $"&status={Uri.EscapeDataString(status)}";


            var response =
                await client.GetFromJsonAsync<
                    PagedResponse<RecommendationDto>>(url);


            if (response != null)
            {

                recommendations =
                    response.Data ??
                    new List<RecommendationDto>();


                totalRecords =
                    response.TotalRecords;


                totalPages =
                    response.TotalPages;

            }

        }
        catch
        {

            error = true;

        }
        finally
        {

            loading = false;

        }

    }


    private async Task ApplyFilters()
    {

        currentPage = 1;

        await LoadRecommendations();

    }


    private async Task ResetFilters()
    {

        search = "";

        tradeId = "";

        recommendationType = "";

        status = "";

        currentPage = 1;

        await LoadRecommendations();

    }


    private async Task PreviousPage()
    {

        if (currentPage > 1)
        {

            currentPage--;

            await LoadRecommendations();

        }

    }


    private async Task NextPage()
    {

        if (currentPage < totalPages)
        {

            currentPage++;

            await LoadRecommendations();

        }

    }


    private string FormatPercentage(decimal? value)
    {

        if (!value.HasValue)
            return "—";

        return $"{value.Value:0.##}%";

    }


    private string FormatCost(decimal? value)
    {

        if (!value.HasValue)
            return "—";

        return value.Value.ToString("N2");

    }


    private string GetConfidenceClass(decimal? value)
    {

        if (!value.HasValue)
            return "metric unknown";

        if (value.Value >= 80)
            return "metric high";

        if (value.Value >= 50)
            return "metric medium";

        return "metric low";

    }


    private string GetRiskReductionClass(decimal? value)
    {

        if (!value.HasValue)
            return "metric unknown";

        if (value.Value >= 70)
            return "metric high";

        if (value.Value >= 40)
            return "metric medium";

        return "metric low";

    }


    private string GetStatusClass(string? value)
    {

        if (string.IsNullOrWhiteSpace(value))
            return "status unknown";


        return value.ToLowerInvariant() switch
        {

            "pending" =>
                "status pending",

            "approved" =>
                "status approved",

            "completed" =>
                "status completed",

            "rejected" =>
                "status rejected",

            _ =>
                "status unknown"

        };

    }


    public class PagedResponse<T>
    {

        public List<T>? Data { get; set; }

        public int Page { get; set; }

        public int PageSize { get; set; }

        public int TotalRecords { get; set; }

        public int TotalPages { get; set; }

    }


    public class RecommendationDto
    {

        public string RecommendationId { get; set; } = "";

        public string TradeId { get; set; } = "";

        public string? TriggerEvent { get; set; }

        public string? RecommendationType { get; set; }

        public string? Action { get; set; }

        public string? Reason { get; set; }

        public string? ExpectedBenefit { get; set; }

        public decimal? EstimatedCost { get; set; }

        public decimal? RiskReduction { get; set; }

        public decimal? Confidence { get; set; }

        public string? Status { get; set; }

    }

}